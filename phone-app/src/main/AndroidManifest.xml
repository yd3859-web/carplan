<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 근처 추천 (3장): asked only when the user taps a recommendation button (Q02). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 7장: scanning the car's invite QR -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The camera is optional (photos can come from the gallery): phones and tablets without one can still install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 17장: push (Q02: asked at first start) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 2장 일정 "n분 전" 알림: 캘린더 앱의 정확한 알람 (33+ 자동 허용, 31–32는 사용자 허용 없으면 대략 시각) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 4장 초대 링크: https://carplan-htb.web.app/i/CODE (App Links; assetlinks.json on Hosting) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="carplan-htb.web.app" android:pathPrefix="/i/" />
            </intent-filter>
            <!-- carplan://i/CODE — what the Hosting page's "앱에서 열기" button sends -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="carplan" android:host="i" />
            </intent-filter>
            <!-- 17장: a tapped push opens that trip day -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="carplan" android:host="trip" />
            </intent-filter>
        </activity>
        <!-- 17장: FCM token + foreground notifications -->
        <receiver android:name=".push.ReminderReceiver" android:exported="false" />
        <service android:name=".push.CarplanMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- 14장: sharing the exported day image -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.htb.carplan.phone.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
