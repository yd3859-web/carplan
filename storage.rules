rules_version = '2';

// 18장: 기록 사진은 records/{groupId}/{eventId}/{date}/{recordId}/{file}.
// 그 그룹의 멤버와 멤버의 차(차 계정 uid = cars/{id}, ownerUid가 멤버)만 읽고 쓴다. 이미지 5MB까지.
// firestore.get/exists를 쓰므로 Storage 서비스 계정에 Firestore 읽기 권한이 필요하다(배포 때 묻는 질문에 Y).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function members(gid) { return firestore.get(/databases/(default)/documents/groups/$(gid)).data.memberIds; }
    function isCar() { return firestore.exists(/databases/(default)/documents/cars/$(me())); }
    function carOwner() { return firestore.get(/databases/(default)/documents/cars/$(me())).data.ownerUid; }
    function canAct(gid) { return me() in members(gid) || (isCar() && carOwner() in members(gid)); }

    match /records/{gid}/{eid}/{date}/{recordId}/{file} {
      allow read: if signedIn() && canAct(gid);
      allow write: if signedIn() && canAct(gid)
        && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
